# Required Railway Variables. DO NOT commit real bot tokens to GitHub.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
# Default: randomly wait so scan starts are approximately 20-30 seconds apart.
POLL_MIN_SECONDS=20
POLL_MAX_SECONDS=30
# A scan checks Naju->Seoul/Yongsan/Suseo individually, then sorts KTX and keeps first 10.
MAX_PAGES_PER_ROUTE=4
HEARTBEAT_MINUTES=60
LOG_DETAIL_EVERY=10
MAX_TRAINS=10
STATE_FILE=state_naju_v9.json
